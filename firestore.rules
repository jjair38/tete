rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    match /stats/{docId} {
      allow get: if true;
      
      allow update: if (
        docId == 'global' &&
        incoming().accessCount == existing().accessCount + 1 &&
        incoming().diff(existing()).affectedKeys().hasOnly(['accessCount', 'lastUpdated'])
      ) || (
        docId == 'global' && !exists(/databases/$(database)/documents/stats/global)
      );

      allow create: if (
        docId == 'global' &&
        incoming().keys().hasAll(['accessCount', 'lastUpdated']) &&
        incoming().accessCount == 1
      );
    }

    match /presence/{sessionId} {
      // Allow everyone to read so they can count online users
      allow read: if true;
      
      // Allow heartbeat updates
      allow create, update: if 
        sessionId.size() >= 10 && sessionId.size() <= 128 &&
        incoming().lastSeen == request.time &&
        incoming().keys().hasOnly(['lastSeen']);
      
      // Allow session cleanup
      allow delete: if true;
    }
  }
}
