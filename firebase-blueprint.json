{
  "entities": {
    "Stats": {
      "title": "Stats",
      "description": "Global application statistics",
      "type": "object",
      "properties": {
        "accessCount": {
          "type": "number",
          "description": "Total number of page views"
        },
        "lastUpdated": {
          "type": "string",
          "format": "date-time",
          "description": "Last time the counter was updated"
        }
      },
      "required": ["accessCount"]
    },
    "Presence": {
      "title": "Presence",
      "description": "Real-time user session status",
      "type": "object",
      "properties": {
        "lastSeen": {
          "type": "string",
          "format": "date-time",
          "description": "Last time the user's session was active"
        }
      },
      "required": ["lastSeen"]
    }
  },
  "firestore": {
    "/stats/global": {
      "schema": "Stats",
      "description": "Global statistics document"
    },
    "/presence/{sessionId}": {
      "schema": "Presence",
      "description": "User session presence document"
    }
  }
}
